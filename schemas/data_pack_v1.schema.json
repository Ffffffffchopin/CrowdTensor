{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crowdtensor.dev/schemas/data_pack_v1.schema.json",
  "title": "CrowdTensor Data Pack v1",
  "type": "object",
  "required": [
    "schema",
    "pack_id",
    "format",
    "license_spdx",
    "source_kind",
    "source_revision",
    "source_uris",
    "records_hash",
    "record_count",
    "byte_count",
    "languages",
    "domains",
    "contributor_id_hash",
    "redistribution_allowed",
    "training_allowed",
    "personal_data_reviewed",
    "copyright_reviewed",
    "benchmark_contamination_reviewed",
    "moderation_status",
    "public_records",
    "admission_ready",
    "raw_records_in_manifest",
    "public_artifact_safe",
    "content_hash"
  ],
  "properties": {
    "schema": {"const": "crowdtensor_data_pack_v1"},
    "pack_id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"},
    "format": {"const": "instruction_sft_jsonl_v1"},
    "license_spdx": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]{1,63}$"
    },
    "source_kind": {
      "enum": ["contributor_authored", "permissive_source", "generated_with_provenance"]
    },
    "source_revision": {"type": "string", "minLength": 1, "maxLength": 256},
    "source_uris": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 512,
        "pattern": "^(?:https://|urn:).+"
      },
      "uniqueItems": true
    },
    "records_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "record_count": {"type": "integer", "minimum": 1},
    "byte_count": {"type": "integer", "minimum": 1},
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"},
      "uniqueItems": true
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"
      },
      "uniqueItems": true
    },
    "contributor_id_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "redistribution_allowed": {"type": "boolean"},
    "training_allowed": {"type": "boolean"},
    "personal_data_reviewed": {"type": "boolean"},
    "copyright_reviewed": {"type": "boolean"},
    "benchmark_contamination_reviewed": {"type": "boolean"},
    "moderation_status": {"enum": ["pending", "approved", "rejected"]},
    "public_records": {"type": "boolean"},
    "admission_ready": {"type": "boolean"},
    "raw_records_in_manifest": {"const": false},
    "public_artifact_safe": {"const": true},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
