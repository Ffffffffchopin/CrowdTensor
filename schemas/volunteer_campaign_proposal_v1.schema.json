{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crowdtensor.dev/schemas/volunteer_campaign_proposal_v1.schema.json",
  "title": "CrowdTensor Volunteer Campaign Proposal v1",
  "type": "object",
  "required": [
    "schema",
    "proposal_id",
    "title",
    "summary",
    "model",
    "dataset",
    "training",
    "evaluation",
    "compute",
    "governance",
    "publication",
    "safety",
    "content_hash"
  ],
  "properties": {
    "schema": {"const": "crowdtensor_volunteer_campaign_proposal_v1"},
    "proposal_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "title": {"type": "string", "minLength": 8, "maxLength": 120},
    "summary": {"type": "string", "minLength": 24, "maxLength": 500},
    "model": {"type": "object"},
    "dataset": {"type": "object"},
    "training": {"type": "object"},
    "evaluation": {"type": "object"},
    "compute": {"type": "object"},
    "governance": {"type": "object"},
    "publication": {"type": "object"},
    "safety": {"type": "object"},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
